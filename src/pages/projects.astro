---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    "number": "01",
    "title": "Geodesic distance loss in PyRoMA",
    "description": "An open-source contribution implementing a more stable geodesic distance loss function for geometric deep learning.",
    "tags": [
      "Python",
      "PyTorch",
      "Open source"
    ]
  },
  {
    "number": "02",
    "title": "Student dorm in virtual reality",
    "description": "A VR simulation of a student dorm, built in Unreal Engine.",
    "tags": [
      "Unreal Engine",
      "VR"
    ]
  },
  {
    "number": "03",
    "title": "Automated candy dispenser",
    "description": "An automated candy dispenser built with a Raspberry Pi.",
    "tags": [
      "Raspberry Pi",
      "Hardware"
    ]
  },
  {
    "number": "04",
    "title": "Ricochet Robots solver",
    "description": "An algorithm for solving the board game Ricochet Robots, implemented in Java.",
    "tags": [
      "Java",
      "Algorithms"
    ]
  },
  {
    "number": "05",
    "title": "Natural language processing model",
    "description": "An NLP model developed with Keras.",
    "tags": [
      "Keras",
      "NLP"
    ]
  },
  {
    "number": "06",
    "title": "Regression for biological experiments",
    "description": "Regression models developed for biological experiments.",
    "tags": [
      "Statistics",
      "Regression"
    ]
  }
];
---

<BaseLayout
  title="Projects — Hampus Serneke"
  description="Selected data science and research projects."
>
  <section class="page-intro container">
    <p class="eyebrow">Selected work</p>
    <h1>Projects</h1>
    <p>
      A selection of things I have built, studied, and explored across data
      science, machine learning, and research.
    </p>
    <a class="text-link" href="https://github.com/HampSwe" target="_blank" rel="noreferrer">Find me on GitHub ↗</a>
  </section>

  <section class="section container">
    <div class="project-grid">
      {projects.map((project) => (
        <article class="project-card">
          <div class="project-topline">
            <span>{project.number}</span>
          </div>

          <div>
            <h2>{project.title}</h2>
            <p>{project.description}</p>
          </div>

          <ul class="tag-list" aria-label="Technologies">
            {project.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
