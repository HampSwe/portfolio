---
interface Props {
  title: string;
  hasAuthors?: boolean;
  venue?: string;
  status?: string;
  href?: string;
}

const { title, hasAuthors = false, venue, status, href } = Astro.props;
---

<article class="research-item">
  <div>
    <h3>
      {href ? <a href={href} target="_blank" rel="noopener noreferrer">{title}</a> : title}
    </h3>
    {hasAuthors && <p class="research-authors"><slot name="authors" /></p>}
    {venue && (
      <p class="research-venue">
        <em>{venue}</em>{status && `, ${status}`}
      </p>
    )}
  </div>
</article>
