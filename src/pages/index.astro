---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TimelineItem from "../components/TimelineItem.astro";
import ResearchItem from "../components/ResearchItem.astro";

// Set to true to display research output.
const showResearchOutput = false;
---

<BaseLayout
  title="Hampus Serneke"
  description="I am an M.Sc. student in Data Science at EPFL in Lausanne, Switzerland. I have a background in Engineering Mathematics from Lund University, Sweden, and I was previously a Summer Undergraduate Research Fellow at Caltech. I am broadly interested in data science, and particularly interested in reinforcement learning, computer vision, robotics and AI safety."
>
  <section class="hero container">
    <div class="portrait-wrap">
      <img
        class="portrait"
        src="/profile.jpg"
        alt="Portrait of Hampus Serneke"
      />
    </div>

    <div class="hero-copy">
      <h1>Hampus Serneke</h1>
      <p class="hero-intro">
        I am an M.Sc. student in Data Science at <a href="https://www.epfl.ch/" target="_blank" rel="noopener noreferrer">EPFL</a> in Lausanne, Switzerland. I have a background
        in Engineering Mathematics from <a href="https://www.lunduniversity.lu.se/" target="_blank" rel="noopener noreferrer">Lund University</a>, Sweden, and I was previously
        a Summer Undergraduate Research Fellow at <a href="https://www.caltech.edu/" target="_blank" rel="noopener noreferrer">Caltech</a>. I am broadly interested in data science, and particularly interested in
        reinforcement learning, computer vision, robotics and AI safety.
      </p>
      <div class="hero-links">
        <a href="https://linkedin.com/in/hampus-serneke" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://github.com/HampSwe" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </section>

  {showResearchOutput && (
  <section class="section container">
    <SectionHeading
      title="Research output"
    />

    <div class="research-list">
      <ResearchItem title="Deep Learning for Rotation Averaging in Structure from Motion" venue="Bachelor’s thesis · Lund University" year="2026" description="Bachelor’s thesis completed as part of the Engineering Mathematics program." />
      <ResearchItem title="Reinforcement learning and AI safety in robotics" venue="AMBER Lab · Caltech" year="2026" description="Summer undergraduate research under the supervision of Dr. Pol Mestres and Prof. Aaron Ames." />
    </div>
  </section>
  )}

  <section class="section container">
    <SectionHeading title="Education" />

    <div class="timeline">
      <TimelineItem date="Sept. 2026 — July 2028" title="M.Sc. in Data Science" logo="/logos/epfl.svg" subtitle="École polytechnique fédérale de Lausanne, EPFL · Lausanne, Switzerland">
        <p class="timeline-description">Current coursework: machine learning, measure theory, math of data, foundations of data science, law of AI</p>
      </TimelineItem>
      <TimelineItem date="Aug. 2022 — June 2026" title="B.Sc., Engineering Mathematics Program" logo="/logos/lth-blue.jpg" subtitle="Lund University, Faculty of Engineering · Lund, Sweden" description="Engineering Mathematics program, following two years in Computer Science and Engineering. GPA: 4.9/5.0. Coursework included mathematical statistics, matrix theory, stochastic processes, PDEs, and algorithms." />
      <TimelineItem date="Aug. 2018 — June 2021" title="Natural Science program" logo="/logos/katedralskolan.png" subtitle="Katedralskolan · Lund, Sweden" description="High school GPA: 22.5/22.5." />
    </div>
  </section>

  <section class="section container">
    <SectionHeading title="Work experience" />

    <div class="timeline">
      <TimelineItem date="June — Aug. 2026" title="Summer Undergraduate Research Fellow" logo="/logos/caltech-orange.svg" subtitle="Caltech, AMBER Lab · Pasadena, USA" description="Research in reinforcement learning and AI safety in robotics with Dr. Pol Mestres and Prof. Aaron Ames. Currently co-authoring a paper with our results." />
      <TimelineItem date="Aug. 2025 — Mar. 2026" title="Teaching Assistant in Mathematics" logo="/logos/lth-blue.jpg" subtitle="Lund University, Faculty of Engineering · Lund, Sweden" description="Led weekly calculus exercise sessions for a class of 30 engineering undergraduates." />
      <TimelineItem date="June 2023 — May 2025" title="Machine Learning Intern" logo="/logos/axis.jpg" subtitle="Axis Communications, Core Technologies Analytics · Lund, Sweden" description="Developed synthetic data pipelines in Unreal Engine to reduce bias in computer vision models. Improved object detection performance, implemented a noise reduction algorithm in Python, and streamlined rendering code in C++. Worked with a team of 10 engineers, part-time during terms and full-time during two summers." />
      <TimelineItem date="Sept. 2018 — Jan. 2023" title="Coding Instructor" logo="/logos/hemkodat.jpg" subtitle="Hemkodat · Sweden" description="Delivered Python, Lua, and C# courses for adolescents across Sweden, and helped onboard and train new instructors." />
    </div>
  </section>

  <section class="section container">
    <SectionHeading title="Extracurriculars" />

    <div class="timeline">
      <TimelineItem date="Jan. — Dec. 2023" title="Vice President" subtitle="The Computer Engineering Guild at LTH · Lund, Sweden" description="Led the board of a student guild with 1,000 members, chaired board meetings, and managed administration." />
    </div>
  </section>
  <section class="section container">
    <SectionHeading title="Awards" />

    <div class="timeline">
      <TimelineItem date="2019" title="European Union Science Olympiad" subtitle="Portugal" description="Won the national qualifiers and received a bronze medal at the European Union Science Olympiad (2019)" />
    </div>
  </section>
  <section class="section container">
    <SectionHeading title="Media coverage" />
    <div class="research-list">
      <article class="research-item">
        <div>
          <div class="research-meta"><span>Helsingborgs Dagblad</span></div>
          <h3><a href="https://www.hd.se/helsingborg/robotar-lockar-mer-an-solsken-unga-far-bygga-eget-pa-biblioteket/" target="_blank" rel="noopener noreferrer">Robots beat sunshine – young people build their own at the library</a></h3>
        </div>
      </article>
      <article class="research-item">
        <div>
          <div class="research-meta"><span>Dalslänningen</span></div>
          <h3><a href="https://www.dalslanningen.se/fargelanda/unga-spelentusiaster-skapade-virtuella-varldar-tusen-spel-i-ett/" target="_blank" rel="noopener noreferrer">Young gaming enthusiasts created virtual worlds – a thousand games in one</a></h3>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
