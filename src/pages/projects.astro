---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectIllustration from "../components/ProjectIllustration.astro";

// Set to false to restore the original text-only project list.
const showProjectIllustrations = false;

// Set to true to display the saved project list.
const showProjects = false;

const projects = [
  {
    "title": "Geodesic distance loss in PyRoMA",
    "description": "An open-source contribution implementing a more stable geodesic distance loss function for geometric deep learning.",
    "tags": [
      "Python",
      "PyTorch",
      "Open source"
    ]
  },
  {
    "title": "Student dorm in virtual reality",
    "description": "A VR simulation of a student dorm, built in Unreal Engine.",
    "tags": [
      "Unreal Engine",
      "VR"
    ]
  },
  {
    "title": "Automated candy dispenser",
    "description": "An automated candy dispenser built with a Raspberry Pi.",
    "tags": [
      "Raspberry Pi",
      "Hardware"
    ]
  },
  {
    "title": "Ricochet Robots solver",
    "description": "An algorithm for solving the board game Ricochet Robots, implemented in Java.",
    "tags": [
      "Java",
      "Algorithms"
    ]
  },
  {
    "title": "Natural language processing model",
    "description": "An NLP model developed with Keras.",
    "tags": [
      "Keras",
      "NLP"
    ]
  },
  {
    "title": "Regression for biological experiments",
    "description": "Regression models developed for biological experiments.",
    "tags": [
      "Statistics",
      "Regression"
    ]
  }
];
---

<BaseLayout
  title="Projects — Hampus Serneke"
  description="Selected data science and research projects."
>
  <section class="page-intro container">
    <h1>Projects</h1>
    <a class="text-link" href="https://github.com/HampSwe" target="_blank" rel="noreferrer">Find me on GitHub ↗</a>
  </section>

  {showProjects && (
  <section class="section container">
    <div class="project-grid">
      {projects.map((project, index) => (
        <article class:list={["project-card", { "with-illustration": showProjectIllustrations }]}>
          {showProjectIllustrations && <ProjectIllustration index={index} />}
          <div class="project-details">
          <div>
            <h2>{project.title}</h2>
            <p>{project.description}</p>
          </div>

          <ul class="tag-list" aria-label="Technologies">
            {project.tags.map((tag) => <li>{tag}</li>)}
          </ul>
          </div>
        </article>
      ))}
    </div>
  </section>
  )}
</BaseLayout>

<style>
  .with-illustration { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 24px; align-items: start; }
  @media (max-width: 560px) {
    .with-illustration { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
